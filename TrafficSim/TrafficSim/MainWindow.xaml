<Window x:Class="TrafficSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traffic Simulator" Height="850" Width="1400"
        Background="#1E1E1E" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BgPanel" Color="#252526"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>

        <Style x:Key="ControlCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#505055"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="0,15,0,15">
                        <TextBlock Text="TRAFFIC SIMULATOR" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentColor}" TextAlignment="Center"/>
                    </StackPanel>

                    <Border Style="{StaticResource ControlCard}">
                        <StackPanel>
                            <TextBlock Text="Grid Setup" Style="{StaticResource HeaderTitle}" TextAlignment="Center"/>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Width" Style="{StaticResource LabelText}" FontSize="11"/>
                                    <TextBox x:Name="TxtGridWidth" Text="25"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height" Style="{StaticResource LabelText}" FontSize="11"/>
                                    <TextBox x:Name="TxtGridHeight" Text="20"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Cell Size (px)" Style="{StaticResource LabelText}" FontSize="11"/>
                            <TextBox x:Name="TxtCellSize" Text="30" Margin="0,0,0,15"/>

                            <Button x:Name="BtnCreateGrid" Content="Create New Grid" Click="BtnCreateGrid_Click"/>
                            <Button x:Name="BtnClear" Content="Clear All" Click="BtnClear_Click" Background="#4A2020"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ControlCard}">
                        <StackPanel>
                            <TextBlock Text="Road Drawing" Style="{StaticResource HeaderTitle}"/>
                            
                            <TextBlock Text="Select Direction:" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="RbNorth" Content="North ↑" GroupName="Direction"/>
                                <RadioButton x:Name="RbEast" Content="East →" GroupName="Direction" IsChecked="True"/>
                                <RadioButton x:Name="RbSouth" Content="South ↓" GroupName="Direction"/>
                                <RadioButton x:Name="RbWest" Content="West ←" GroupName="Direction"/>
                            </UniformGrid>

                            <TextBlock Text="Left-click (drag): draw roads  |  Right-click (drag): erase"
                                       FontSize="11" Foreground="#888" Margin="0,10,0,0" TextWrapping="Wrap" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ControlCard}">
                        <StackPanel>
                            <TextBlock Text="Lane Network" Style="{StaticResource HeaderTitle}"/>

                            <Button x:Name="BtnBuildNetwork" Content="Build Network" 
                                    Click="BtnBuildNetwork_Click" Background="{StaticResource AccentColor}"/>

                            <TextBlock x:Name="NetworkInfoText" Text="Status: Network not built" 
                                       FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ControlCard}">
                        <StackPanel>
                            <TextBlock Text="Simulation Control" Style="{StaticResource HeaderTitle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnStartSim" Content="▶ Start" Click="BtnStartSim_Click" Background="#2D5A30"/>
                                <Button Grid.Column="2" x:Name="BtnStopSim" Content="⏸ Stop" Click="BtnStopSim_Click" Background="#664400"/>
                            </Grid>

                            <CheckBox x:Name="ChkCollisions" Content="Enable Collisions" 
                                      IsChecked="True" Foreground="{StaticResource TextSecondary}" Margin="0,10"/>

                            <Separator Background="#444" Margin="0,5,0,10"/>
                            <DockPanel LastChildFill="False" Margin="0,0,0,5">
                                <TextBlock Text="Speed Multiplier" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="TxtSimSpeed" Text="1.0x" FontWeight="Bold" 
                                           Foreground="{StaticResource AccentColor}" DockPanel.Dock="Right"/>
                            </DockPanel>
                            
                            <Slider x:Name="SliderSimSpeed" Minimum="0.1" Maximum="3.0" Value="1.0" 
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ControlCard}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Active Cars:" Style="{StaticResource HeaderTitle}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CarCountText" Text="0" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Background="#121212">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="20" Background="#2D2D30" CornerRadius="4" BorderBrush="#3E3E42" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both">
                    <Canvas x:Name="GridCanvas"
                            Background="#181818"
                            Width="2000" Height="2000"
                            MouseLeftButtonDown="GridCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="GridCanvas_MouseLeftButtonUp"
                            MouseMove="GridCanvas_MouseMove"
                            MouseRightButtonDown="GridCanvas_RightClick"
                            MouseRightButtonUp="GridCanvas_MouseRightButtonUp">
                    </Canvas>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource BgPanel}" Padding="10,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="STATUS:" FontWeight="Bold" Foreground="{StaticResource AccentColor}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" 
                               Text="Ready. Draw roads with left-click, then build network to start." 
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>