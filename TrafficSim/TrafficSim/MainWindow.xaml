<Window x:Class="TrafficSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traffic Simulator" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#f0f0f0" Margin="5">
            <GroupBox Header="Grid Settings" Padding="5" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Grid Size:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtGridWidth" Width="60" Text="30" Margin="0,0,5,0"/>
                    <TextBlock Text="x" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtGridHeight" Width="60" Text="20" Margin="0,0,10,0"/>
                    <Button x:Name="BtnCreateGrid" Content="Create Grid" Click="BtnCreateGrid_Click" Padding="10,5" Margin="0,0,20,0"/>
                    
                    <TextBlock Text="Cell Size (px):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtCellSize" Width="60" Text="30" Margin="0,0,10,0"/>
                    
                    <Button x:Name="BtnClear" Content="Clear Grid" Click="BtnClear_Click" Padding="10,5"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Traffic Direction" Padding="5" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbNorth" Content="↑ North" GroupName="Direction" Margin="5,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbEast" Content="→ East" GroupName="Direction" Margin="5,0" VerticalAlignment="Center" IsChecked="True"/>
                    <RadioButton x:Name="RbSouth" Content="↓ South" GroupName="Direction" Margin="5,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbWest" Content="← West" GroupName="Direction" Margin="5,0" VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Simulation" Padding="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider x:Name="SliderSimSpeed" Width="100" Minimum="0.1" Maximum="3" Value="1" 
                            TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSimSpeed" Text="1.0x" Width="40" VerticalAlignment="Center" Margin="5,0,10,0"/>
                    
                    <CheckBox x:Name="ChkCollisions" Content="Enable Collisions" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Main Canvas -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#e8e8e8">
            <Canvas x:Name="GridCanvas" Background="White" 
                    MouseLeftButtonDown="GridCanvas_MouseLeftButtonDown"
                    MouseMove="GridCanvas_MouseMove" 
                    MouseLeftButtonUp="GridCanvas_MouseLeftButtonUp"
                    MouseRightButtonDown="GridCanvas_RightClick"/>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready. Click 'Create Grid' to start. Left-click to draw roads, Right-click to spawn cars."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CarCountText" Text="Cars: 0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
