<Window x:Class="TrafficSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traffic Simulator" Height="850" Width="1400"
        Background="{StaticResource WindowBackground}" FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource WindowBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,15,12,15">

                    <TextBlock Text="Traffic Simulator" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" TextAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Layout editor and simulation controls"
                               Foreground="{StaticResource TextSecondary}"
                               TextAlignment="Center"
                               Margin="0,0,0,14"/>

                    <Border Style="{StaticResource ControlCard}">
                        <StackPanel>
                            <TextBlock Text="FILE" Style="{StaticResource SectionLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnSave" Content="Save"
                                        Click="BtnSave_Click" Margin="0"/>
                                <Button Grid.Column="2" x:Name="BtnLoad" Content="Load"
                                        Click="BtnLoad_Click" Margin="0"/>
                            </Grid>
                            <Button x:Name="BtnMainMenu" Content="Main Menu"
                                    Click="BtnMainMenu_Click" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="GridSetupCard" Style="{StaticResource ControlCard}">
                        <StackPanel>
                            <TextBlock Text="GRID SETUP" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Width" Style="{StaticResource LabelText}" FontSize="10"/>
                                    <TextBox x:Name="TxtGridWidth" Text="25"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height" Style="{StaticResource LabelText}" FontSize="10"/>
                                    <TextBox x:Name="TxtGridHeight" Text="20"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Cell px" Style="{StaticResource LabelText}" FontSize="10"/>
                                    <TextBox x:Name="TxtCellSize" Text="30"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnCreateGrid" Content="Apply Grid"
                                        Click="BtnCreateGrid_Click" Margin="0"/>
                                <Button Grid.Column="2" x:Name="BtnClear" Content="Clear"
                                        Click="BtnClear_Click" Margin="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RoadDrawingCard" Style="{StaticResource ControlCard}">
                        <StackPanel>
                            <TextBlock Text="ROAD DRAWING" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="Direction or node type" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,6"/>
                            <Grid HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Row="0" Grid.Column="2"
                                             x:Name="RbNorth" Content="North"
                                             GroupName="Direction" Style="{StaticResource SegmentedRadio}"/>
                                <RadioButton Grid.Row="2" Grid.Column="0"
                                             x:Name="RbWest" Content="West"
                                             GroupName="Direction" Style="{StaticResource SegmentedRadio}"/>
                                <RadioButton Grid.Row="2" Grid.Column="2"
                                             x:Name="RbJunction" Content="Junction"
                                             GroupName="Direction" Style="{StaticResource SegmentedRadio}"
                                             ToolTip="Place a junction (intersection)"/>
                                <RadioButton Grid.Row="2" Grid.Column="4"
                                             x:Name="RbEast" Content="East"
                                             GroupName="Direction" IsChecked="True"
                                             Style="{StaticResource SegmentedRadio}"/>
                                <RadioButton Grid.Row="4" Grid.Column="2"
                                             x:Name="RbSouth" Content="South"
                                             GroupName="Direction" Style="{StaticResource SegmentedRadio}"/>
                            </Grid>

                            <StackPanel Margin="0,12,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbJunction}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Speed Limit (mph)" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <RadioButton Grid.Row="0" Grid.Column="0" x:Name="RbSpeed20" Content="20"
                                                 GroupName="SpeedLimit" Tag="20"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                    <RadioButton Grid.Row="0" Grid.Column="1" x:Name="RbSpeed30" Content="30"
                                                 GroupName="SpeedLimit" Tag="30" IsChecked="True"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                    <RadioButton Grid.Row="0" Grid.Column="2" x:Name="RbSpeed40" Content="40"
                                                 GroupName="SpeedLimit" Tag="40"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                    <RadioButton Grid.Row="2" Grid.Column="0" x:Name="RbSpeed50" Content="50"
                                                 GroupName="SpeedLimit" Tag="50"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                    <RadioButton Grid.Row="2" Grid.Column="1" x:Name="RbSpeed60" Content="60"
                                                 GroupName="SpeedLimit" Tag="60"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                    <RadioButton Grid.Row="2" Grid.Column="2" x:Name="RbSpeed70" Content="70"
                                                 GroupName="SpeedLimit" Tag="70"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbJunction}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Junction Type" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" x:Name="RbGiveWay" Content="Give Way"
                                                 GroupName="JunctionType" IsChecked="True"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                    <RadioButton Grid.Column="1" x:Name="RbTrafficLight" Content="T. Light"
                                                 GroupName="JunctionType"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                </Grid>
                                <TextBlock Text="Use the junction marker on the map to configure give-way rules and turn restrictions."
                                           Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Text="Left drag draws. Right drag erases."
                                       FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ControlCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="SIMULATION" Style="{StaticResource SectionLabel}"/>

                            <Button x:Name="BtnBuildNetwork" Content="Build Network"
                                    Click="BtnBuildNetwork_Click"/>
                            <TextBlock x:Name="NetworkInfoText" Text="Network not built"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}"/>

                            <StackPanel x:Name="SimRunControlsPanel" Visibility="Collapsed">
                                <Separator Background="{StaticResource BorderBrush}" Margin="0,10"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BtnStartSim" Content="Start"
                                            Click="BtnStartSim_Click" Margin="0"/>
                                    <Button Grid.Column="2" x:Name="BtnStopSim" Content="Stop"
                                            Click="BtnStopSim_Click" Margin="0"/>
                                </Grid>

                                <Button x:Name="BtnViewStatistics" Content="View Statistics"
                                        Click="BtnViewStatistics_Click"
                                        Margin="0,0,0,6"/>

                                <CheckBox x:Name="ChkCollisions" Content="Enable Collisions"
                                          IsChecked="True" Foreground="{StaticResource TextSecondary}"
                                          Margin="0,4,0,10"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="Speed" Style="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="TxtSimSpeed" Text="1.0x" FontWeight="Bold"
                                               Foreground="{StaticResource AccentColour}" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderSimSpeed" Minimum="0.1" Maximum="3.0" Value="1.0"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="SELECTED NODE" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="TxtNoNodeSelected"
                                           Text="Click a spawn / exit / junction on the canvas"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,6"
                                           TextWrapping="Wrap"/>

                                <StackPanel x:Name="PanelSpawnNode" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtSelectedSpawnNode" Text="SPAWN NODE (0, 0)"
                                               Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,4"/>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="Spawn Rate" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="TxtSpawnInterval" Text="8 cars/min" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentColour}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="SliderSpawnInterval" Minimum="1" Maximum="120" Value="8"
                                            TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>
                                </StackPanel>

                                <StackPanel x:Name="PanelExitNode" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtSelectedExitNode" Text="EXIT NODE (0, 0)"
                                               Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,4"/>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="Weight" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="TxtExitWeight" Text="1.0" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentColour}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="SliderExitWeight" Minimum="0" Maximum="5.0" Value="1.0"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>
                                </StackPanel>

                                <StackPanel x:Name="PanelTrafficLight" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtSelectedTrafficLight" Text="JUNCTION (0, 0)"
                                               Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,4"/>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="Green" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="TxtGreenDuration" Text="20 s" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentColour}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="SliderGreenDuration" Minimum="5" Maximum="60" Value="20"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,6"/>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="Yellow" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="TxtYellowDuration" Text="3.0 s" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentColour}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="SliderYellowDuration" Minimum="1" Maximum="10" Value="3"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,6"/>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="All-Red Gap" Style="{StaticResource LabelText}"/>
                                        <TextBlock x:Name="TxtAllRedDuration" Text="1.0 s" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentColour}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="SliderAllRedDuration" Minimum="0" Maximum="5" Value="1"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>
                                </StackPanel>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                                <Button x:Name="BtnReturnToEditing" Content="Return to Editing"
                                        Click="BtnReturnToEditing_Click" Margin="0"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource PanelBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="16" Background="{StaticResource SurfaceBackground}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both">
                    <Canvas x:Name="GridCanvas"
                            Background="#F8F7F2"
                            Width="2000" Height="2000"
                            MouseLeftButtonDown="GridCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="GridCanvas_MouseLeftButtonUp"
                            MouseMove="GridCanvas_MouseMove"
                            MouseRightButtonDown="GridCanvas_MouseRightButtonDown"
                            MouseRightButtonUp="GridCanvas_MouseRightButtonUp">
                    </Canvas>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource PanelBackground}" Padding="10,6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock x:Name="FpsText" Text="FPS: --" FontWeight="Bold"
                               Foreground="{StaticResource AccentColour}" DockPanel.Dock="Right" Margin="15,0,0,0"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="15,0,0,0">
                        <TextBlock Text="Cars: " FontWeight="Bold" Foreground="{StaticResource AccentColour}"/>
                        <TextBlock x:Name="CarCountText" Text="0" FontWeight="Bold"
                                   Foreground="{StaticResource AccentColour}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="STATUS: " FontWeight="Bold" Foreground="{StaticResource AccentColour}"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Draw roads with left-click, then build network to start."
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
