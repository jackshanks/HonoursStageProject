<Window x:Class="TrafficSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traffic Simulator" Height="850" Width="1400"
        Background="#1E1E1E" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BgPanel" Color="#252526"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>

        <Style x:Key="ControlCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#505055"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-style radio buttons for cell type / direction / junction type -->
        <Style x:Key="SegmentedRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="#3E3E42" Padding="8,7" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#505055"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgDark}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,15,12,15">

                    <TextBlock Text="TRAFFIC SIMULATOR" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentColor}" TextAlignment="Center"
                               Margin="0,0,0,15"/>

                    <!-- Grid Setup (compact) -->
                    <Border Style="{StaticResource ControlCard}">
                        <StackPanel>
                            <TextBlock Text="GRID SETUP" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Width" Style="{StaticResource LabelText}" FontSize="10"/>
                                    <TextBox x:Name="TxtGridWidth" Text="25"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height" Style="{StaticResource LabelText}" FontSize="10"/>
                                    <TextBox x:Name="TxtGridHeight" Text="20"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Cell px" Style="{StaticResource LabelText}" FontSize="10"/>
                                    <TextBox x:Name="TxtCellSize" Text="30"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnCreateGrid" Content="Apply Grid"
                                        Click="BtnCreateGrid_Click" Margin="0"/>
                                <Button Grid.Column="2" x:Name="BtnClear" Content="Clear"
                                        Click="BtnClear_Click" Background="#4A2020" Margin="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Road Drawing -->
                    <Border Style="{StaticResource ControlCard}">
                        <StackPanel>
                            <TextBlock Text="ROAD DRAWING" Style="{StaticResource SectionLabel}"/>

                            <!-- Cell Type segmented toggle -->
                            <TextBlock Text="Cell Type" Foreground="#666" FontSize="10" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" x:Name="RbCellRoad" Content="Road"
                                             GroupName="CellType" IsChecked="True"
                                             Style="{StaticResource SegmentedRadio}"/>
                                <RadioButton Grid.Column="1" x:Name="RbIntersection" Content="Intersection"
                                             GroupName="CellType"
                                             Style="{StaticResource SegmentedRadio}"/>
                            </Grid>

                            <!-- Direction compass (Road only) -->
                            <StackPanel Visibility="{Binding IsChecked, ElementName=RbCellRoad, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Direction" Foreground="#666" FontSize="10" Margin="0,0,0,6"/>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Row="0" Grid.Column="2"
                                                 x:Name="RbNorth" Content="↑  N"
                                                 GroupName="Direction" Style="{StaticResource SegmentedRadio}"/>
                                    <RadioButton Grid.Row="2" Grid.Column="0"
                                                 x:Name="RbWest" Content="←  W"
                                                 GroupName="Direction" Style="{StaticResource SegmentedRadio}"/>
                                    <Border Grid.Row="2" Grid.Column="2" Background="#1A1A1E" CornerRadius="4"/>
                                    <RadioButton Grid.Row="2" Grid.Column="4"
                                                 x:Name="RbEast" Content="E  →"
                                                 GroupName="Direction" IsChecked="True"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                    <RadioButton Grid.Row="4" Grid.Column="2"
                                                 x:Name="RbSouth" Content="↓  S"
                                                 GroupName="Direction" Style="{StaticResource SegmentedRadio}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Junction Type (Intersection only) -->
                            <StackPanel Visibility="{Binding IsChecked, ElementName=RbIntersection, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Junction Type" Foreground="#666" FontSize="10" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" x:Name="RbGiveWay" Content="Give Way"
                                                 GroupName="JunctionType" IsChecked="True"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                    <RadioButton Grid.Column="1" x:Name="RbStop" Content="Stop"
                                                 GroupName="JunctionType"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                    <RadioButton Grid.Column="2" x:Name="RbTrafficLight" Content="T. Light"
                                                 GroupName="JunctionType"
                                                 Style="{StaticResource SegmentedRadio}"/>
                                </Grid>

                                <!-- Give Way direction config (Give Way type only) -->
                                <StackPanel Visibility="{Binding IsChecked, ElementName=RbGiveWay, Converter={StaticResource BoolToVis}}"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="Selected Junction" Foreground="#666" FontSize="10" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtSelectedJunction" Text="(none — click a junction)"
                                               Foreground="#888" FontSize="10" Margin="0,0,0,6"/>
                                    <TextBlock Text="Give Way Directions" Foreground="#666" FontSize="10" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="4"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox Grid.Row="0" Grid.Column="0" x:Name="ChkGiveWayNorth" Content="↑ North"
                                                  Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0"/>
                                        <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ChkGiveWayEast"  Content="→ East"
                                                  Foreground="{StaticResource TextSecondary}"/>
                                        <CheckBox Grid.Row="2" Grid.Column="0" x:Name="ChkGiveWaySouth" Content="↓ South"
                                                  Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0"/>
                                        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ChkGiveWayWest"  Content="← West"
                                                  Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Left-drag: draw  ·  Right-drag: erase"
                                       FontSize="10" Foreground="#555" Margin="0,10,0,0" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- Simulation (includes Build Network + run controls) -->
                    <Border Style="{StaticResource ControlCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="SIMULATION" Style="{StaticResource SectionLabel}"/>

                            <Button x:Name="BtnBuildNetwork" Content="⚙  Build Network"
                                    Click="BtnBuildNetwork_Click" Background="{StaticResource AccentColor}"/>
                            <TextBlock x:Name="NetworkInfoText" Text="Network not built"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}"/>

                            <!-- Hidden until network is built -->
                            <StackPanel x:Name="SimRunControlsPanel" Visibility="Collapsed">
                                <Separator Background="#3E3E42" Margin="0,10"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BtnStartSim" Content="▶  Start"
                                            Click="BtnStartSim_Click" Background="#2D5A30" Margin="0"/>
                                    <Button Grid.Column="2" x:Name="BtnStopSim" Content="⏸  Stop"
                                            Click="BtnStopSim_Click" Background="#664400" Margin="0"/>
                                </Grid>

                                <CheckBox x:Name="ChkCollisions" Content="Enable Collisions"
                                          IsChecked="True" Foreground="{StaticResource TextSecondary}"
                                          Margin="0,4,0,10"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="Speed" Style="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="TxtSimSpeed" Text="1.0×" FontWeight="Bold"
                                               Foreground="{StaticResource AccentColor}" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderSimSpeed" Minimum="0.1" Maximum="3.0" Value="1.0"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                                <Separator Background="#3E3E42" Margin="0,0,0,8"/>
                                <Button x:Name="BtnReturnToEditing" Content="← Return to Editing"
                                        Click="BtnReturnToEditing_Click" Margin="0"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main canvas area -->
        <Grid Grid.Column="1" Background="#121212">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="20" Background="#2D2D30" CornerRadius="4"
                    BorderBrush="#3E3E42" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both">
                    <Canvas x:Name="GridCanvas"
                            Background="#181818"
                            Width="2000" Height="2000"
                            MouseLeftButtonDown="GridCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="GridCanvas_MouseLeftButtonUp"
                            MouseMove="GridCanvas_MouseMove"
                            MouseRightButtonDown="GridCanvas_RightClick"
                            MouseRightButtonUp="GridCanvas_MouseRightButtonUp">
                    </Canvas>
                </ScrollViewer>
            </Border>

            <!-- Status bar with Active Cars -->
            <Border Grid.Row="1" Background="{StaticResource BgPanel}" Padding="10,6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock x:Name="FpsText" Text="FPS: --" FontWeight="Bold"
                               Foreground="{StaticResource AccentColor}" DockPanel.Dock="Right" Margin="15,0,0,0"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="15,0,0,0">
                        <TextBlock Text="Cars: " FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                        <TextBlock x:Name="CarCountText" Text="0" FontWeight="Bold"
                                   Foreground="{StaticResource AccentColor}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="STATUS: " FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Draw roads with left-click, then build network to start."
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>