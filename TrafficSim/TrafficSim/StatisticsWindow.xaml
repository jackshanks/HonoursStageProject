<Window x:Class="TrafficSim.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traffic Statistics" Height="620" Width="760"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="Duration: " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <TextBlock x:Name="TxtDuration" Text="0m 0s"
                           Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock Text="Traffic Statistics" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">

            <Border Style="{StaticResource ControlCard}" Margin="0,0,6,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="VOLUME" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="TxtVolume" Text="0"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentColour}"/>
                    <TextBlock Text="vehicles completed" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ControlCard}" Margin="3,0,3,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="FLOW" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="TxtFlow" Text="0"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentColour}"/>
                    <TextBlock Text="vehicles / hour" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ControlCard}" Margin="3,0,3,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="AVG SPEED" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="TxtSpeed" Text="0"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentColour}"/>
                    <TextBlock Text="mph (space-mean)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ControlCard}" Margin="6,0,0,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="DENSITY" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="TxtDensity" Text="0"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentColour}"/>
                    <TextBlock Text="vehicles / km" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <TextBlock Grid.Row="2" Text="PER-LANE BREAKDOWN  (lanes with traffic, sorted by flow)"
                   Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBackground}" Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="LaneDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionUnit="FullRow"
                      Background="{StaticResource SurfaceBackground}"
                      Foreground="{StaticResource TextPrimary}"
                      BorderThickness="0"
                      RowBackground="{StaticResource SurfaceBackground}"
                      AlternatingRowBackground="{StaticResource PanelBackground}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      HeadersVisibility="Column">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="130"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
                    <DataGridTextColumn Header="Length (m)" Binding="{Binding LengthM, StringFormat=F1}" Width="90"/>
                    <DataGridTextColumn Header="Avg Cars" Binding="{Binding AvgOccupancy, StringFormat=F2}" Width="80"/>
                    <DataGridTextColumn Header="Speed (mph)" Binding="{Binding AvgSpeedMph, StringFormat=F1}" Width="95"/>
                    <DataGridTextColumn Header="Density (veh/km)" Binding="{Binding AvgDensityVehPerKm, StringFormat=F1}" Width="120"/>
                    <DataGridTextColumn Header="Flow (veh/h)" Binding="{Binding AvgFlowVehPerHour, StringFormat=F1}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Button Grid.Row="4" x:Name="BtnClose" Content="Close"
                Click="BtnClose_Click"
                HorizontalAlignment="Right" Width="100" Margin="0"/>
    </Grid>
</Window>
