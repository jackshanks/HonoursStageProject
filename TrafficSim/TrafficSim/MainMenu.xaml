<Window x:Class="TrafficSim.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traffic Simulator" Height="520" Width="480"
        Background="{StaticResource WindowBackground}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">

    <Grid Margin="24">
        <Border Style="{StaticResource ControlCard}" VerticalAlignment="Center" Padding="20">
            <StackPanel>
                <TextBlock Text="Traffic Simulator" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Create a new road layout or reopen an existing one."
                           Foreground="{StaticResource TextSecondary}"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <Button x:Name="BtnNewNetwork" Content="New Network"
                        Click="BtnNewNetwork_Click"
                        FontSize="14" Padding="12,7" Margin="0,0,0,8"/>

                <Button x:Name="BtnLoadNetwork" Content="Load Network"
                        Click="BtnLoadNetwork_Click"
                        FontSize="14" Padding="12,7" Margin="0,0,0,12"/>

                <Border Style="{StaticResource ControlCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="PRE-BUILT NETWORKS" Style="{StaticResource SectionLabel}"/>
                        <ListBox x:Name="PrebuiltList"
                                 MaxHeight="180"
                                 MouseDoubleClick="PrebuiltList_DoubleClick"/>
                        <Button x:Name="BtnLoadPrebuilt" Content="Open Selected"
                                Click="BtnLoadPrebuilt_Click" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
